  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectableItem
  ItemName: Muddy Footprints
  ItemDescription: Small boot prints, a woman's size, in wet mud from Agatha's chair
    to the foot of the ladder. Tom wears enormous hobnailed boots, and Percy never
    sets foot in the mud. Whoever made these stood by her chair, then climbed out.
  ClueID: GH_FOOTPRINTS
  NotebookNote: A woman's small boots, from the chair to the ladder.
  CanPickUp: 0
  DisplayOffset: {x: 0, y: 0, z: 0}
  DisplayEulerRotation: {x: 0, y: 0, z: 0}
