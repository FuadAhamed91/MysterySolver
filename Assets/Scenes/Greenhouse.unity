  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectableItem
  ItemName: Gardener's Diary
  ItemDescription: 'Tom Briar''s work diary, left on the boiler ledge: <i>Lady A
    locked herself in at 10 to watch her bloom. Stoked the boiler till 2, then to
    bed.</i> In the margin he has drawn his own enormous hobnailed boots, a joke
    about the mud.'
  ClueID: GH_DIARY
  NotebookNote: Tom stoked the boiler till 2. Huge hobnailed boots.
  CanPickUp: 1
  DisplayOffset: {x: 0, y: 0.1, z: -0.1}
  DisplayEulerRotation: {x: 90, y: 180, z: 0}
