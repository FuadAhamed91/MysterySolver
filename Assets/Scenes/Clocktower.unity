  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectableItem
  ItemName: Cast-Brass Gooseneck Lamp
  ItemDescription: 'The cowl has been wrenched down onto the drafting sheet to spotlight
    a shaky pencil note: <i>"The tonic... so bitter. Hands numb. 3:03."</i> No name.
    Whoever brought that tonic, Vance wanted it seen.'
